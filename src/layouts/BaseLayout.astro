---
/**
 * Base page shell: <html lang/dir>, SEO + social metadata, hreflang,
 * theme bootstrap (no flash), header, footer.
 */
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langs, languages, useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';
import { absoluteUrl, localePath, withBase } from '../utils/url';
import { optionalAsset } from '../utils/assets';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Use `title` exactly as given (home page) instead of "Title | MEZO TECH". */
  fullTitle?: boolean;
  /** Top-level nav section to highlight. */
  pageKey?: string;
  /** Static route shared by both languages, e.g. "/about/". Both language versions exist. */
  route?: string;
  /** Alternative to `route`: paths (with base) of the translations that REALLY exist. */
  alternates?: Partial<Record<Lang, string>>;
  /** Where the language switcher falls back to when no translation exists. */
  section?: 'blog' | 'projects';
  /** Override the canonical path (default: current page). */
  canonicalPath?: string;
  /** Social image: path under /public (e.g. a post cover). Falls back to the default image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  article?: { published: Date; modified?: Date; tags: string[]; section?: string };
}

const {
  lang,
  title,
  description,
  fullTitle = false,
  pageKey,
  route,
  alternates: alternatesProp,
  section,
  canonicalPath,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd = [],
  article,
} = Astro.props;

const t = useTranslations(lang);
const meta = languages[lang];

// --- translations that really exist ---
const alternates: Partial<Record<Lang, string>> =
  alternatesProp ?? (route ? Object.fromEntries(langs.map((l) => [l, localePath(l, route)])) : { [lang]: Astro.url.pathname });

// --- language switcher targets (never a missing route) ---
const targets = Object.fromEntries(
  langs.map((l) => {
    const exact = alternates[l];
    return [
      l,
      exact
        ? { href: exact, exact: true }
        : { href: localePath(l, section ? `/${section}/` : '/'), exact: false },
    ];
  }),
) as Record<Lang, { href: string; exact: boolean }>;

// --- SEO ---
const pageTitle = fullTitle ? title : `${title} | ${site.name}`;
const canonical = absoluteUrl(canonicalPath ?? alternates[lang] ?? Astro.url.pathname);
const existing = langs.filter((l) => alternates[l]);
const xDefault = alternates.en ?? alternates[existing[0] ?? lang];
const ogImagePath = optionalAsset(image) ?? withBase(site.defaultOgImage);
const ogImage = absoluteUrl(ogImagePath);
const ogAlt = imageAlt ?? `${site.name} — ${site.tagline[lang]}`;
const otherLocales = existing.filter((l) => l !== lang);

const ldJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0B1120" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme bootstrap: runs before first paint so the wrong theme never flashes -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.setAttribute('data-theme', t);
      })();
    </script>

    <!-- Icons -->
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <!-- Translations (only the ones that exist) -->
    {existing.map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(alternates[l]!)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault)} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — RSS`} href={localePath(lang, '/rss.xml')} />

    <!-- Open Graph / X (Twitter) -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }

    {jsonLd.map((data) => <script type="application/ld+json" set:html={ldJson(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <Header lang={lang} current={pageKey} targets={targets} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} targets={targets} />
  </body>
</html>
