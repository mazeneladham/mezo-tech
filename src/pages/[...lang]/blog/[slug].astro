---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PostCard from '../../../components/PostCard.astro';
import ShareLinks from '../../../components/ShareLinks.astro';
import ArticleEnhancements from '../../../components/ArticleEnhancements.astro';
import Icon from '../../../components/Icon.astro';
import { alternatesFor, getAllPosts, getPosts, relatedPosts, type Post } from '../../../utils/content';
import { optionalAsset } from '../../../utils/assets';
import { formatDate, isoDate } from '../../../utils/format';
import { absoluteUrl, localePath } from '../../../utils/url';
import { languages, useTranslations, type Lang } from '../../../i18n/ui';
import { categoryLabel, tagLabel } from '../../../data/taxonomy';
import { site } from '../../../data/site';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { lang: post.lang === 'en' ? undefined : post.lang, slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const lang: Lang = post.lang;
const t = useTranslations(lang);
const d = post.data;

const { Content, headings } = await render(post.entry);
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocItems.length >= 3;

const all = await getAllPosts();
const alternates = alternatesFor(all, post.key);
const ordered = await getPosts(lang);
const index = ordered.findIndex((p) => p.key === post.key);
const older = index >= 0 ? ordered[index + 1] : undefined; // "previous" article = the one published before this
const newer = index > 0 ? ordered[index - 1] : undefined; // "next" article = the one published after
const related = relatedPosts(all, post);

const coverUrl = optionalAsset(d.cover);
const category = categoryLabel(lang, d.category);
const canonical = absoluteUrl(post.path);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    inLanguage: lang,
    mainEntityOfPage: canonical,
    url: canonical,
    author: { '@type': 'Organization', name: site.authorName },
    publisher: { '@type': 'Organization', name: site.name },
    ...(coverUrl ? { image: absoluteUrl(coverUrl) } : {}),
    keywords: d.tags.join(', '),
    articleSection: category,
  },
];
---

<BaseLayout
  lang={lang}
  title={d.title}
  description={d.description}
  pageKey="blog"
  alternates={alternates}
  section="blog"
  image={d.cover}
  imageAlt={d.coverAlt}
  type="article"
  article={{ published: d.pubDate, modified: d.updatedDate, tags: d.tags, section: category }}
  jsonLd={jsonLd}
>
  <ArticleEnhancements lang={lang} progress />

  <div class="container">
    <header class="article-header">
      <Breadcrumbs lang={lang} items={[{ label: t.nav.blog, href: localePath(lang, '/blog/') }, { label: d.title }]} />
      <div class="badge-row">
        <span class="badge">{category}</span>
        {d.example && <span class="badge badge--example">{t.common.exampleBadge}</span>}
      </div>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <ul class="meta">
        <li>{t.common.published}: <time datetime={isoDate(d.pubDate)}>{formatDate(d.pubDate, lang)}</time></li>
        {
          d.updatedDate && (
            <li>{t.common.updated}: <time datetime={isoDate(d.updatedDate)}>{formatDate(d.updatedDate, lang)}</time></li>
          )
        }
        <li>{t.common.minRead(post.readingTime)}</li>
        <li lang={lang}>{languages[lang].name}</li>
      </ul>
      {
        d.tags.length > 0 && (
          <ul class="tag-list" aria-label={t.common.tags}>
            {d.tags.map((tag) => <li class="tag">{tagLabel(lang, tag)}</li>)}
          </ul>
        )
      }
    </header>

    {
      coverUrl && (
        <div class="article-cover">
          <img src={coverUrl} alt={d.coverAlt ?? ''} width="1200" height="675" decoding="async" fetchpriority="high" />
        </div>
      )
    }

    <div class:list={['article-layout', { 'article-layout--toc': hasToc }]} data-article>
      {
        hasToc && (
          <details class="toc" open>
            <summary>{t.common.toc}</summary>
            <ol data-toc>
              {tocItems.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>

    <ShareLinks lang={lang} url={canonical} title={d.title} />

    <nav class="post-nav" aria-label={`${t.common.prevArticle} / ${t.common.nextArticle}`}>
      {
        older ? (
          <a class="prev" href={older.path} rel="prev">
            <small><Icon name="arrow-back" size={14} class="icon-dir" />{t.common.prevArticle}</small>
            <strong>{older.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a class="next" href={newer.path} rel="next">
            <small>{t.common.nextArticle}<Icon name="arrow" size={14} class="icon-dir" /></small>
            <strong>{newer.data.title}</strong>
          </a>
        )
      }
    </nav>

    {
      related.length > 0 && (
        <section class="section" aria-labelledby="related-title" style="border-block-start:0">
          <h2 id="related-title" style="margin-block-end: var(--space-5)">{t.common.relatedArticles}</h2>
          <div class="grid">
            {related.map((p) => <PostCard post={p} lang={lang} />)}
          </div>
        </section>
      )
    }

    <p style="padding-block: var(--space-6)">
      <a class="text-link" href={localePath(lang, '/blog/')}>
        <Icon name="arrow-back" size={18} class="icon-dir" />{t.common.backToBlog}
      </a>
    </p>
  </div>
</BaseLayout>
