---
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
  id?: string;
  linkHref?: string;
  linkLabel?: string;
}
const { title, intro, eyebrow, id, linkHref, linkLabel } = Astro.props;
---

<div class="section-header">
  <div class="section-header__text">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2 id={id}>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
  {
    linkHref && linkLabel && (
      <a class="text-link" href={linkHref}>
        {linkLabel}
        <svg class="icon-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    )
  }
</div>
