---
import { useTranslations, type Lang } from '../i18n/ui';
import { localePath } from '../utils/url';
interface Props {
  lang: Lang;
  items: { label: string; href?: string }[];
}
const { lang, items } = Astro.props;
const t = useTranslations(lang);
const all = [{ label: t.nav.home, href: localePath(lang, '/') }, ...items];
---

<nav class="breadcrumbs" aria-label={t.a11y.breadcrumb}>
  <ol>
    {
      all.map((item, i) => (
        <li>
          {item.href && i < all.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current={i === all.length - 1 ? 'page' : undefined}>{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
